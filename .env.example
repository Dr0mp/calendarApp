# Copy to .env and fill in. .env is git-ignored.

# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Used ONCE, only if users.json has no "admin" account yet. At least 12 characters.
ADMIN_INITIAL_PASSWORD=

# Optional
PORT=3000
# USERS_FILE=./users.json
# TOKEN_TTL_HOURS=12
# Set to 1 when served over HTTPS
# COOKIE_SECURE=1
# Comma-separated list; leave empty for same-origin only (recommended)
# ALLOWED_ORIGINS=
# Passkeys: the exact origin(s) users open the app at (scheme + host + port), comma-separated.
# Default: http://localhost:PORT and http://127.0.0.1:PORT. Set it when you deploy, e.g.
# APP_ORIGINS=https://calendar.example.com
# Where workspace data (data/workspace.json) and uploads live. Default: ./data
# DATA_DIR=./data
# Storage cap for events + posts, including their images/videos (GB)
# STORAGE_CAP_GB=8
# Largest single upload (MB)
# MAX_UPLOAD_MB=100
# Demo accounts: their own storage cap (MB) and the hour (0-23) of the nightly reset
# DEMO_STORAGE_CAP_MB=200
# DEMO_RESET_HOUR=3
# Login attempts allowed per IP per 15 minutes
# LOGIN_RATE_LIMIT_MAX=20
# Demo accounts shown on the login screen, working on a sample copy that resets (set 0 to disable)
# ENABLE_DEMO_ACCOUNTS=1
# DEMO_PASSWORD=demo123
